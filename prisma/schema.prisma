generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  engineType      = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Teacher {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  tests        Test[]
}

model Test {
  id             String       @id @default(cuid())
  title          String
  description    String?
  timeLimit      Int?         // minutes, null = no limit
  startAt        DateTime?
  endAt          DateTime?
  testCode       String       @unique
  isActive       Boolean      @default(true)
  showAnswers    Boolean      @default(false)
  showPerQuestion Boolean     @default(true)
  maxAttempts    Int          @default(1)
  displayMode    String       @default("ALL") // ALL | ONE_BY_ONE
  createdAt      DateTime     @default(now())
  teacher        Teacher      @relation(fields: [teacherId], references: [id])
  teacherId      String
  questions      Question[]
  submissions    Submission[]
}

model Question {
  id            String   @id @default(cuid())
  test          Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  testId        String
  type          String   // MCQ | NUMERICAL
  text          String
  options       Json?    // Array of strings for MCQ ["A. ...", "B. ...", "C. ...", "D. ..."]
  correctAnswer String   // Option index "0","1","2","3" for MCQ; number string for NUMERICAL
  tolerance     Float?   // Allowed ± deviation for NUMERICAL (null = exact match)
  marks         Int      @default(1)
  explanation   String?
  order         Int      @default(0)
  answers       Answer[]
}

model Submission {
  id          String   @id @default(cuid())
  test        Test     @relation(fields: [testId], references: [id])
  testId      String
  studentName String
  studentRoll String
  submittedAt DateTime @default(now())
  totalScore  Float    @default(0)
  maxScore    Float    @default(0)
  isPublished Boolean  @default(false)
  answers     Answer[]
}

model Answer {
  id            String     @id @default(cuid())
  submission    Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  submissionId  String
  question      Question   @relation(fields: [questionId], references: [id])
  questionId    String
  studentAnswer String     // what the student typed/selected
  marksAwarded  Float      @default(0)
  isCorrect     Boolean    @default(false)
}
