generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  engineType      = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Teacher {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  name         String
  createdAt    DateTime     @default(now())
  tests        Test[]
  students     Student[]
  attendances  Attendance[]
}

model Test {
  id             String       @id @default(cuid())
  title          String
  description    String?
  timeLimit      Int?         // minutes, null = no limit
  startAt        DateTime?
  endAt          DateTime?
  resultsPublishAt DateTime? // Scheduled time to auto-publish results
  testCode       String       @unique
  isActive       Boolean      @default(true)
  showAnswers    Boolean      @default(false)
  showPerQuestion Boolean     @default(true)
  maxAttempts    Int          @default(1)
  displayMode    String       @default("ALL") // ALL | ONE_BY_ONE
  createdAt      DateTime     @default(now())
  teacher        Teacher      @relation(fields: [teacherId], references: [id])
  teacherId      String
  questions      Question[]
  submissions    Submission[]
}

model Question {
  id            String   @id @default(cuid())
  test          Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  testId        String
  type          String   // MCQ | NUMERICAL
  text          String
  options       Json?    // Array of strings for MCQ ["A. ...", "B. ...", "C. ...", "D. ..."]
  correctAnswer String   // Option index "0","1","2","3" for MCQ; number string for NUMERICAL
  tolerance     Float?   // Allowed ± deviation for NUMERICAL (null = exact match)
  marks         Int      @default(1)
  explanation   String?
  order         Int      @default(0)
  answers       Answer[]
}

model Submission {
  id          String   @id @default(cuid())
  test        Test     @relation(fields: [testId], references: [id])
  testId      String
  studentName String
  studentRoll String
  submittedAt DateTime @default(now())
  totalScore  Float    @default(0)
  maxScore    Float    @default(0)
  isPublished Boolean  @default(false)
  answers     Answer[]
}

model Answer {
  id            String     @id @default(cuid())
  submission    Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  submissionId  String
  question      Question   @relation(fields: [questionId], references: [id])
  questionId    String
  studentAnswer String     // what the student typed/selected
  marksAwarded  Float      @default(0)
  isCorrect     Boolean    @default(false)
}

model Enquiry {
  id        String   @id @default(cuid())
  name      String
  phone     String
  course    String
  message   String?
  status    String   @default("PENDING") // PENDING | CONTACTED | ENROLLED | CLOSED
  notes     String?
  createdAt DateTime @default(now())
}

model Student {
  id           String       @id           // Teacher-assigned student ID
  firstName    String
  middleName   String
  surname      String
  dob          DateTime
  class        String
  mobile       String
  parentMobile String
  mothersName  String
  teacher      Teacher      @relation(fields: [teacherId], references: [id])
  teacherId    String
  attendances  Attendance[]
}

model Attendance {
  id        String   @id @default(cuid())
  student   Student  @relation(fields: [studentId], references: [id])
  studentId String
  teacher   Teacher  @relation(fields: [teacherId], references: [id])
  teacherId String
  date      DateTime
  status    String   // PRESENT | ABSENT | LATE etc.
  remarks   String?

  @@unique([studentId, date])
}
